<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="android:Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/background_black</item>
    </style>

    <style name="ControlButton">
        <item name="android:minHeight">@dimen/control_button_height</item>
        <item name="android:textSize">@dimen/control_text_size</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Visually secondary controls: Mirror, Exit, Preview/Stop. Smaller
         than ControlButton so Start Prompter reads as the primary action. -->
    <style name="SecondaryControlButton">
        <item name="android:minHeight">@dimen/secondary_button_height</item>
        <item name="android:textSize">@dimen/secondary_text_size</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:padding">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Shared by btnEditorCancel and btnEditorSave only, so the two can
         never independently diverge from each other again. Kept as its
         own style (not just an alias of SecondaryControlButton) so a
         future change to the main screen's secondary buttons can't
         silently resize the editor's Cancel/Save row too. -->
    <style name="EditorActionButton">
        <item name="android:minHeight">@dimen/secondary_button_height</item>
        <item name="android:textSize">@dimen/secondary_text_size</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:padding">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
