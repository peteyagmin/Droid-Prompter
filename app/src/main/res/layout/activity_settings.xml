<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_black">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/control_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/text_white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Text Alignment -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_text_alignment"
                android:textColor="@color/accent_amber"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/textAlignmentGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radioAlignLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_align_left"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:paddingRight="24dp"
                    android:paddingEnd="24dp" />

                <RadioButton
                    android:id="@+id/radioAlignCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_align_center"
                    android:textColor="@color/text_white"
                    android:textSize="16sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/adjustment_divider_width"
                android:background="@color/divider_color"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:clickable="false"
                android:focusable="false" />

            <!-- Prompter Orientation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_prompter_orientation"
                android:textColor="@color/accent_amber"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/prompterOrientationGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radioOrientationHorizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_orientation_horizontal"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:paddingRight="24dp"
                    android:paddingEnd="24dp" />

                <RadioButton
                    android:id="@+id/radioOrientationVertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_orientation_vertical"
                    android:textColor="@color/text_white"
                    android:textSize="16sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/adjustment_divider_width"
                android:background="@color/divider_color"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:clickable="false"
                android:focusable="false" />

            <!-- Mirror Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_mirror_mode"
                android:textColor="@color/accent_amber"
                android:textSize="18sp" />

            <RadioGroup
                android:id="@+id/mirrorModeGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radioMirrorModeFlip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_mirror_mode_flip"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:paddingRight="24dp"
                    android:paddingEnd="24dp" />

                <RadioButton
                    android:id="@+id/radioMirrorModeFlipRotate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_mirror_mode_flip_rotate"
                    android:textColor="@color/text_white"
                    android:textSize="16sp" />
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/adjustment_divider_width"
                android:background="@color/divider_color"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:clickable="false"
                android:focusable="false" />

            <!-- Load Last Script on Launch -->
            <CheckBox
                android:id="@+id/loadLastScriptCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_section_load_last_script"
                android:textColor="@color/text_white"
                android:textSize="18sp" />

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="@dimen/control_padding">

        <Button
            android:id="@+id/btnAbout"
            style="@style/ControlButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/btn_about" />

        <Button
            android:id="@+id/btnSettingsDone"
            style="@style/ControlButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:text="@string/btn_settings_done" />
    </LinearLayout>

</LinearLayout>
