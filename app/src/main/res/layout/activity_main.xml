<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_black">

    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_black"
        android:padding="@dimen/control_padding">

        <!-- Top file row: [Load Script][New Script]  Loaded: filename  [Edit Script] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnOpenFile"
                style="@style/ControlButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/secondary_text_size"
                android:text="@string/btn_open_file" />

            <Button
                android:id="@+id/btnNewScript"
                style="@style/ControlButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                android:textSize="@dimen/secondary_text_size"
                android:text="@string/btn_new_script" />

            <TextView
                android:id="@+id/currentFileLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginLeft="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginEnd="12dp"
                android:text="@string/no_file_loaded"
                android:textColor="@color/text_light_gray"
                android:textSize="16sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="middle" />

            <Button
                android:id="@+id/btnEditScript"
                style="@style/ControlButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/secondary_text_size"
                android:text="@string/btn_edit_script" />
        </LinearLayout>

        <!-- Primary action row: Start Prompter (dominant) + Mirror + Exit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnStart"
                style="@style/ControlButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginRight="8dp"
                android:layout_marginEnd="8dp"
                android:textSize="@dimen/secondary_text_size"
                android:text="@string/btn_start" />

            <ToggleButton
                android:id="@+id/mirrorToggle"
                style="@style/SecondaryControlButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:layout_marginEnd="8dp"
                android:textOn="@string/mirror_on"
                android:textOff="@string/mirror_off" />

            <Button
                android:id="@+id/btnExit"
                style="@style/SecondaryControlButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_exit" />
        </LinearLayout>

        <!-- Font size + speed row, separated by a subtle vertical divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="38"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/font_size_static_label"
                    android:textColor="@color/text_white"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnFontDecrease"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:text="@string/btn_font_decrease" />

                <TextView
                    android:id="@+id/fontSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginRight="6dp"
                    android:layout_marginEnd="6dp"
                    android:minWidth="40dp"
                    android:gravity="center"
                    android:textColor="@color/accent_amber"
                    android:textSize="18sp"
                    android:text="@string/font_size_default_label" />

                <Button
                    android:id="@+id/btnFontIncrease"
                    style="@style/ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:text="@string/btn_font_increase" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/adjustment_divider_width"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="@dimen/adjustment_divider_vertical_margin"
                android:layout_marginBottom="@dimen/adjustment_divider_vertical_margin"
                android:background="@color/divider_color"
                android:clickable="false"
                android:focusable="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="59"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speed_prefix"
                    android:textColor="@color/text_white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/speedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="32dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:textColor="@color/accent_amber"
                    android:textSize="18sp"
                    android:text="@string/speed_default_label" />

                <SeekBar
                    android:id="@+id/speedSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnPreview"
                    style="@style/SecondaryControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="96dp"
                    android:text="@string/btn_preview" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <FrameLayout
        android:id="@+id/fullScreenContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_black">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_black"
            android:scrollbars="none"
            android:fillViewport="true">

            <TextView
                android:id="@+id/scriptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:textColor="@color/text_white"
                android:textSize="@dimen/script_default_text_size"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/default_script_placeholder" />
        </ScrollView>

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:background="@drawable/countdown_background"
            android:paddingLeft="48dp"
            android:paddingRight="48dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:gravity="center"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:textSize="@dimen/countdown_text_size" />

        <TextView
            android:id="@+id/tapInstructionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            android:background="@drawable/countdown_background"
            android:paddingLeft="48dp"
            android:paddingRight="48dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:gravity="center"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:text="@string/tap_to_start"
            android:textSize="@dimen/tap_instruction_text_size" />

        <!-- Last child so it draws on top of scrollView/countdownText/
             tapInstructionText and, being clickable, intercepts every touch
             within fullScreenContainer while visible: the script stays
             visible but non-interactive beneath the scrim. -->
        <LinearLayout
            android:id="@+id/pauseMenuOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/pause_menu_scrim"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <Button
                android:id="@+id/btnResume"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp"
                android:text="@string/btn_resume" />

            <Button
                android:id="@+id/btnRestart"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:layout_marginRight="16dp"
                android:layout_marginEnd="16dp"
                android:text="@string/btn_restart" />

            <Button
                android:id="@+id/btnBackToControls"
                style="@style/ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp"
                android:text="@string/btn_back_to_controls" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
