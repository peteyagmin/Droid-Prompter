<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF000000" />
            <stroke android:width="3dp" android:color="#FFFFC107" />
        </shape>
    </item>
    <item
        android:left="12dp"
        android:top="16dp"
        android:right="12dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFC107" />
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="10dp"
        android:right="20dp"
        android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
